# Copiar a .env y completar. El .env no se sube al repositorio (está en .gitignore).

# Kaggle: Account -> Settings -> API -> Create New API Token descarga un kaggle.json con estos dos valores.
# Sirve para que la sección 2 del notebook baje el dataset aliabdelmenam/rdd-2022.
KAGGLE_USERNAME=tu_usuario
KAGGLE_KEY=tu_api_key

# Weights & Biases: la key está en https://wandb.ai/authorize
# Sin esta variable el notebook corre igual, sólo que sin registrar la corrida.
WANDB_API_KEY=tu_api_key
WANDB_PROJECT=bachemap
# BACHEMAP_WANDB=0    # descomentar para desactivar W&B aunque haya key

# Opcionales:
# BACHEMAP_INPUT=/ruta/al/dataset   # si ya está descargado, saltea la descarga de Kaggle
# BACHEMAP_WORK=./bachemap_work     # dónde se escriben los artefactos
# BACHEMAP_PRUEBA=1                 # corrida corta en CPU para probar el código
